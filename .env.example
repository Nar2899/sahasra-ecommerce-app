# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# STRIPE_SECRET_KEY: Optional Stripe Secret Key (sk_test_...) for live Stripe PaymentIntents.
# When omitted, the backend uses its deterministic HMAC-signed Stripe PaymentIntent engine.
STRIPE_SECRET_KEY=""

# STRIPE_WEBHOOK_SECRET: Optional Stripe Webhook signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=""

# SPRING_BOOT_UPSTREAM_URL: Optional external Java Spring Boot cluster URL if proxying to an external JVM instance.
SPRING_BOOT_UPSTREAM_URL=""

# Real Email OTP Delivery Configuration (Nodemailer SMTP / Gmail App Password)
# Configure these in the AI Studio Secrets panel to deliver 6-digit login OTPs directly to customer inboxes.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="sahasrajewels <noreply@sahasrajewels.com>"

# Optional: Resend API Key (https://resend.com) as an alternative transactional email provider
RESEND_API_KEY=""

# Optional: GitHub Personal Access Token (with repo scope) for pushing commits to https://github.com/Nar2899/sahasra-ecommerce-app
GITHUB_TOKEN=""


